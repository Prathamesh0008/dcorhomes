# Authentication origin: http://localhost:3000 locally; exact HTTPS site origin in production.
SITE_URL=
# MongoDB is used only for authentication and administrative accounts.
# Read-only historical exports use their explicitly selected source settings.
# Preserve the existing production database and secrets. Do not bootstrap/reset existing accounts.
MONGODB_URI=
MONGODB_DB=
BETTER_AUTH_SECRET=
# Retained for legacy signed-session tooling; not needed by public page rendering.
SESSION_SECRET=
# Configure a Resend-verified sender. No successful enquiry is reported without provider acceptance.
# Recipient is fixed to sales@dcorhome.com in the server route.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Compatibility sender alias (used if RESEND_FROM_EMAIL is absent).
ENQUIRY_FROM_EMAIL=
# Enable only behind a trusted proxy that controls forwarding headers.
TRUST_PROXY=false
# Local HTTP checks only; false in HTTPS production.
ALLOW_LOCAL_HTTP=false
# Optional approved business WhatsApp number: country code and digits only.
DCORHOME_WHATSAPP_NUMBER=
# Optional ONLY for the operator's read-only export of earlier private assets.
# The public site and manual studio do not use object storage, uploads or AI services.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# No DCORHOME_DATA_DIR, SQLite path or machine-specific persistence is required.
