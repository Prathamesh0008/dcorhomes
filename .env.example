# Canonical origin, required for member auth. Use the approved HTTPS domain in production.
SITE_URL=
# Node 24.x. All persistent application records and member auth use MongoDB (below).
# Legacy DCORHOME_DATA_DIR / DCORHOME_DATABASE_URL are not read by runtime code.
# Generate at least 32 random characters. Never use the example as a secret.
SESSION_SECRET=
# At least 20 random characters. No public/default admin password exists.
# Legacy shared administrator password is no longer used for authentication.
ADMIN_PASSWORD=
# Private S3-compatible object storage is required for private uploads on every host.
# Public bundled catalogue / visualizer assets remain in public/.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Explicitly opt in only after storage, provider billing and usage controls are configured.
DCORHOME_AI_ENABLED=false
OPENAI_API_KEY=
DCORHOME_IMAGE_MODEL=gpt-image-2.5-sunburst
DCORHOME_IMAGE_QUALITY=medium
DCORHOME_MAX_GENERATIONS_PER_GUEST=3
DCORHOME_MAX_CONCURRENT_GENERATIONS=1
# /api/visualizer/generate uses masked image edits. Uploads stay in the browser
# until explicit generation; AI also requires private metadata/image storage above.
AI_DAILY_LIMIT=5
# Enable only behind a proxy that replaces, rather than appends untrusted forwarding headers.
TRUST_PROXY=false
# Local HTTP testing only. Keep false for public HTTPS deployments.
ALLOW_LOCAL_HTTP=false
# Generated previews expire at this age; configure authenticated scheduled cleanup.
# Minimum 32 random characters, used only by the retention scheduler.
CRON_SECRET=
RETENTION_DAYS=30
# Optional Resend notification; enquiry persistence works without email.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# Verified business WhatsApp number: country code plus digits only, no + or spaces.
# Leave empty to disable WhatsApp until the business number is confirmed.
DCORHOME_WHATSAPP_NUMBER=

# Customer auth: independent random secret (32+ characters). SITE_URL is required.
BETTER_AUTH_SECRET=
# Invite-only member auth uses the existing intended MongoDB database.
MONGODB_URI=
# Optional when the URI already selects the database; set to your existing database name.
MONGODB_DB=
# Run npm run auth:migrate, then npm run auth:bootstrap -- owner.id "Owner Name".
DCORHOME_CONTACT_EMAIL=sales@dcorhome.com
# ENQUIRY_FROM_EMAIL must be a Resend-verified sender/domain.
