# Optional public origin; keep unset until the real domain is approved.
SITE_URL=
# Node 24+ single-server SQLite metadata on a durable private volume, outside public/.
DCORHOME_DATA_DIR=
# Generate at least 32 random characters. Never use the example as a secret.
SESSION_SECRET=
# At least 20 random characters. No public/default admin password exists.
ADMIN_PASSWORD=
# Private image storage: local for development/single-host protected volumes; otherwise S3.
ASSET_STORAGE=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Explicitly opt in only after storage, provider billing and usage controls are configured.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
AI_DAILY_LIMIT=5
# Enable only behind a proxy that replaces, rather than appends untrusted forwarding headers.
TRUST_PROXY=false
# Local HTTP testing only. Keep false for public HTTPS deployments.
ALLOW_LOCAL_HTTP=false
# Administrator-triggered cleanup uses this age; schedule it operationally.
RETENTION_DAYS=30
# Optional Resend notification; enquiry persistence works without email.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
