{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified curtain supplier catalogue",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "slug",
      "name",
      "category",
      "description",
      "source",
      "usage",
      "colors",
      "images",
      "compatibleHeadingStyles"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "source": {
        "enum": [
          "demo",
          "supplier"
        ]
      },
      "usage": {
        "type": "array",
        "minItems": 1,
        "items": {
          "enum": [
            "main",
            "sheer"
          ]
        }
      },
      "description": {
        "type": "string"
      },
      "sku": {
        "type": "string"
      },
      "brand": {
        "type": "string"
      },
      "supplierReference": {
        "type": "string"
      },
      "composition": {
        "type": "string"
      },
      "weave": {
        "type": "string"
      },
      "opacity": {
        "type": "string"
      },
      "fabricWidthCm": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "weightGsm": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "thicknessMm": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "blackoutPercentage": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "pattern": {
        "type": "string"
      },
      "patternRepeatCm": {
        "type": "object",
        "required": [
          "horizontal",
          "vertical"
        ],
        "properties": {
          "horizontal": {
            "type": "number",
            "minimum": 0
          },
          "vertical": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "careInstructions": {
        "type": "string"
      },
      "shrinkage": {
        "type": "string"
      },
      "certifications": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "pricePerMetre": {
        "type": "number",
        "minimum": 0
      },
      "currency": {
        "type": "string"
      },
      "availability": {
        "type": "string"
      },
      "minimumOrderMetres": {
        "type": "number",
        "minimum": 0
      },
      "leadTime": {
        "type": "string"
      },
      "images": {
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "string",
          "pattern": "^/(images/|api/catalogue/images/)"
        }
      },
      "compatibleHeadingStyles": {
        "type": "array",
        "minItems": 1,
        "items": {
          "enum": [
            "Wave Pleat",
            "Pinch Pleat",
            "Eyelet",
            "Pencil Pleat",
            "Goblet Pleat",
            "Rod Pocket"
          ]
        }
      },
      "colors": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "name",
            "colorCode",
            "family",
            "available"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "colorCode": {
              "type": "string"
            },
            "hexPreview": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "family": {
              "type": "string"
            },
            "swatchImage": {
              "type": "string",
              "pattern": "^/(images/|api/catalogue/images/)"
            },
            "variantSku": {
              "type": "string"
            },
            "available": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "mainImage": {
              "type": "string"
            },
            "images": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "availability": {
              "type": "string"
            },
            "active": {
              "type": "boolean"
            },
            "textureImage": {
              "type": "string",
              "pattern": "^/(images/|api/catalogue/images/)"
            },
            "drapedImage": {
              "type": "string",
              "pattern": "^/(images/|api/catalogue/images/)"
            },
            "digitalPreviewImage": {
              "type": "string",
              "pattern": "^/(images/|api/catalogue/images/)"
            },
            "digitalSwatchImage": {
              "type": "string",
              "pattern": "^/(images/|api/catalogue/images/)"
            },
            "digitalPreviewImages": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/(images/|api/catalogue/images/)"
              }
            }
          }
        }
      },
      "categoryId": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "variety": {
        "type": "string"
      },
      "collection": {
        "type": "string"
      },
      "texture": {
        "type": "string"
      },
      "construction": {
        "type": "string"
      },
      "lightFiltering": {
        "type": "string"
      },
      "liningCompatibility": {
        "type": "string"
      },
      "washing": {
        "type": "string"
      },
      "dryCleaning": {
        "type": "string"
      },
      "ironing": {
        "type": "string"
      },
      "linearWeightGm": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "rollLengthM": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "active": {
        "type": "boolean"
      },
      "applications": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
